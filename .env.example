# Copy to .env and fill in real values. Never commit .env.

# Database
DATABASE_URL=postgresql+psycopg://postgres:vaish@123@localhost:5432/emp_erp

# JWT
JWT_SECRET_KEY=change-me-generate-with-secrets.token_urlsafe(64)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption (Fernet key for TOTP secrets at rest) - generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me

# 2FA
TOTP_ISSUER_NAME=EmpERP

# Seed super admin (used once by scripts/seed_super_admin.py)
SUPER_ADMIN_EMAIL=admin@emperp.dev
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_COMPANY_NAME=Default Company

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Auth hardening
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Email - "console" logs instead of sending (default for local dev); "smtp" sends for real
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@emperp.dev
